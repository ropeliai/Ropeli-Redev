# Vercel production environment.
# Copy these keys into Vercel: Project Settings → Environment Variables.
# Do NOT commit real values — this file only documents which keys are needed.

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key (Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: VITE_BACKEND_URL is NOT required — vercel.json rewrites /api/* to
# the Render backend, so the frontend can always call /api/... directly.
